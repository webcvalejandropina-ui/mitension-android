    <string name="s_b1b0cb8e" formatted="false">How to measure blood pressure</string>
    <string name="s_5f56ebdd" formatted="false">Prepare your monitor</string>
    <string name="s_7c829133" formatted="false">Use a validated upper-arm monitor with a cuff that fits. This app records the monitor\'s readings.</string>
    <string name="s_5778ea1" formatted="false">Before measuring</string>
    <string name="s_d9208800" formatted="false">Avoid exercise, tobacco and caffeine for 30 minutes beforehand. Empty your bladder.</string>
    <string name="s_85e87776" formatted="false">Rest for 5 minutes</string>
    <string name="s_3e61eef1" formatted="false">Sit quietly with your back supported, feet on the floor and legs uncrossed.</string>
    <string name="s_9ee49f60" formatted="false">Position your arm</string>
    <string name="s_bce0d3dc" formatted="false">Place the cuff on bare skin following the monitor\'s instructions. Support your arm at heart level.</string>
    <string name="s_7351154d" formatted="false">Take two readings</string>
    <string name="s_a38f8d7f" formatted="false">Do not talk or move. Wait at least 1 minute between readings and save each one separately.</string>
    <string name="s_996169f1" formatted="false">Follow your care plan</string>
    <string name="s_7bdf6efa" formatted="false">Measure at the times recommended by your healthcare professional and bring the report to your appointment.</string>
    <string name="s_f5d01df6" formatted="false">Source: American Heart Association</string>
    <string name="s_f3051bee" formatted="false">Your privacy</string>
    <string name="s_ea1c8dca" formatted="false">We do not store data on servers</string>
    <string name="s_96f4866e" formatted="false">Your readings and notes are saved only on this Android so you can review your history. The app does not require an account or send your readings to our servers.</string>
    <string name="s_3c612b37" formatted="false">You decide whether to export or share a report or backup. Device backups may include app data depending on your Android settings.</string>
    <string name="s_cfff210d" formatted="false">Deleting the app may erase local history. Export a backup to keep it.</string>
